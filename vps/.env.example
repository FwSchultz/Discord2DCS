# Discord Bot
DISCORD_TOKEN=DEIN_DISCORD_BOT_TOKEN
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_GUILD_ID=123456789012345678

# Discord Admin-Oberflaeche
ADMIN_USER_IDS=123456789012345678
ADMIN_ROLE_IDS=
ADMIN_CHANNEL_ID=0
ADMIN_LOG_CHANNEL_ID=0
ALLOW_GUILD_ADMIN=false

# Interne WebSocket-Bridge
WS_BIND=0.0.0.0
WS_PORT=8766
WS_ALLOWED_PATHS=/ws,/
QUEUE_SIZE=50
MIRROR_BOTS=false
LOG_LEVEL=INFO

# Schutz gegen Chat-Spam pro Client
CLIENT_MESSAGE_LIMIT=6
CLIENT_MESSAGE_WINDOW_SECONDS=10

# Reverse Proxy / TLS
# Fuer Community-Betrieb empfohlen:
PUBLIC_HOSTNAME=discord2dcs.example.com
PUBLIC_WS_URL=wss://discord2dcs.example.com/ws
TRUST_PROXY_HEADERS=true
REQUIRE_PROXY_TLS=true

# SQLite / persistente Daten
DATA_DIR=/data
DB_FILE=/data/discord2dcs.db

# Optional: nur fuer alte v0.3.x-PC-Clients waehrend der Migration.
# Nach Migration aller Clients leer lassen/entfernen.
BRIDGE_SECRET=
DCS_DISPLAY_NAME=DCS-Pilot

# Direkte TLS-Terminierung in Python bleibt als Fallback erhalten.
# Bei Caddy/Nginx MUSS TLS_ENABLED=false bleiben, weil der Proxy TLS beendet.
TLS_ENABLED=false
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
